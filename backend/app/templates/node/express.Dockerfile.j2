# --- Dependency stage: install production node_modules in isolation. ---
FROM {{ base_image | default("node:20-slim", true) }} AS deps

WORKDIR /app

# Copy manifests first so this layer is cached unless dependencies change.
COPY package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev

# --- Runtime stage: copy the app and installed modules into the final image. ---
FROM {{ base_image | default("node:20-slim", true) }} AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT={{ port | default(3000, true) }}

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

# The official node image ships a built-in non-root 'node' user; run as it.
USER node

# Document the port the application listens on.
EXPOSE {{ port | default(3000, true) }}

# Start the application.
CMD ["sh", "-c", "{{ startup_command | default('node index.js', true) }}"]
