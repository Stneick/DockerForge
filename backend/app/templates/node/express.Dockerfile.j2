# syntax=docker/dockerfile:1
FROM {{ base_image | default("node:20-slim", true) }} AS deps

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev

FROM {{ base_image | default("node:20-slim", true) }} AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT={{ port | default(3000, true) }}

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

USER node

EXPOSE {{ port | default(3000, true) }}

CMD ["sh", "-c", "{{ startup_command | default('node index.js', true) }}"]
