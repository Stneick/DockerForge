# syntax=docker/dockerfile:1

# --- Dependency stage: install production node_modules in isolation. ---
FROM {{ base_image | default("node:20-alpine", true) }} AS deps

WORKDIR /app

COPY package*.json ./
# Leverage a cache mount to /root/.npm to speed up subsequent builds.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev || npm install --omit=dev

# --- Runtime stage: copy the app and installed modules into the final image. ---
FROM {{ base_image | default("node:20-alpine", true) }} AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT={{ port | default(3000, true) }}

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

# The official node image ships a built-in non-root 'node' user; run as it.
USER node

# Document the port the application listens on.
EXPOSE {{ port | default(3000, true) }}

# Start the application.
CMD ["sh", "-c", "{{ startup_command | default('node index.js', true) }}"]
