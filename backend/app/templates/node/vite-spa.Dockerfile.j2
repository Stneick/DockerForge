# syntax=docker/dockerfile:1
FROM {{ base_image | default("node:20-slim", true) }} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci || npm install

COPY . .

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

RUN {{ startup_command | default("npm run build", true) }}

FROM nginx:stable-alpine AS runtime

COPY --from=builder /app/{{ build_output_dir | default("dist", true) }} /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen {{ port | default(80, true) }};' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

EXPOSE {{ port | default(80, true) }}
