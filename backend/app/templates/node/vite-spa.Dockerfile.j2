# syntax=docker/dockerfile:1

# --- Build stage: install deps and produce the static bundle. ---
FROM {{ base_image | default("node:20-alpine", true) }} AS builder

WORKDIR /app

COPY package*.json ./
# Leverage a cache mount to /root/.npm to speed up subsequent builds.
RUN --mount=type=cache,target=/root/.npm \
    npm ci || npm install

COPY . .

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

RUN {{ startup_command | default("npm run build", true) }}

# --- Runtime stage: serve the built static files with Nginx (no Node needed). ---
FROM nginx:stable-alpine AS runtime

COPY --from=builder /app/{{ build_output_dir | default("dist", true) }} /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen {{ port | default(80, true) }};' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

# Document the port Nginx listens on.
EXPOSE {{ port | default(80, true) }}
