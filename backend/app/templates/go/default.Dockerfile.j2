# syntax=docker/dockerfile:1
FROM {{ base_image | default("golang:1.22-alpine", true) }} AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY . .

RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /out/{{ binary_name | default("server", true) }} {{ build_package | default(".", true) }}

FROM alpine:3.19 AS runtime

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app
COPY --from=builder /out/{{ binary_name | default("server", true) }} .

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

USER appuser

{% if port %}
EXPOSE {{ port }}
{% endif %}

CMD ["./{{ binary_name | default('server', true) }}"]
