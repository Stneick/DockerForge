# --- Build stage: compile a small, static binary. ---
FROM {{ base_image | default("golang:1.22-alpine", true) }} AS builder

WORKDIR /src

# git/certs/tzdata cover common needs of `go build` (VCS info, TLS, zoneinfo).
RUN apk add --no-cache git ca-certificates tzdata

# Download dependencies first so this layer is reused when only source changes.
COPY go.* ./
RUN go mod download

COPY . .

# Build a static binary (CGO off); -ldflags/-trimpath strip and shrink it.
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /out/{{ binary_name | default("server", true) }} {{ build_package | default(".", true) }}

# --- Runtime stage: a tiny image with just the binary and CA certs. ---
FROM alpine:3.19 AS runtime

# Add CA certs/timezones and a non-root user to run the app as.
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app
COPY --from=builder /out/{{ binary_name | default("server", true) }} .

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

USER appuser

# Document the port the application listens on.
{% if port %}
EXPOSE {{ port }}
{% endif %}

# Start the application.
CMD ["./{{ binary_name | default('server', true) }}"]
