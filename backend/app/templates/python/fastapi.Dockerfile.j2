# syntax=docker/dockerfile:1

# --- Build stage: install dependencies into a virtualenv using a full image. ---
# Build tools live here and are left behind, keeping the final image small.
FROM {{ base_image | default("python:3.12-slim", true) }} AS builder

WORKDIR /app

# build-essential provides the C compilers some Python packages need to build.
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

{% set dep_file = dependency_file | default("requirements.txt", true) %}
COPY {{ dep_file }} ./
# Download dependencies as a separate step to take advantage of Docker's caching.
# Leverage a cache mount to /root/.cache/pip to speed up subsequent builds.
{% if dep_file in ["pyproject.toml", "setup.py", "setup.cfg"] %}
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install . uvicorn
{% else %}
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r {{ dep_file }} uvicorn
{% endif %}

# --- Runtime stage: a clean, smaller image with only the app and its venv. ---
FROM {{ base_image | default("python:3.12-slim", true) }} AS runtime

WORKDIR /app

# Run as a non-root user instead of root for better security.
RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup --no-create-home appuser

COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appgroup . .

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT={{ port | default(8000, true) }}

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

USER appuser

# Document the port the application listens on.
EXPOSE {{ port | default(8000, true) }}

# Start the application.
{% if startup_command %}
CMD ["sh", "-c", "{{ startup_command }}"]
{% else %}
CMD ["sh", "-c", "uvicorn {{ entry_point | default('main:app', true) }} --host 0.0.0.0 --port ${PORT}"]
{% endif %}
