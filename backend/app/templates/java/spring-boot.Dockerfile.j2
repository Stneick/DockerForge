# --- Build stage: compile and package the app into a single jar. ---
FROM {{ base_image | default("maven:3.9-eclipse-temurin-21", true) }} AS builder

WORKDIR /app

COPY . .
# Build the jar, then copy it to a predictable name (app.jar) for the next stage.
RUN mvn -B -DskipTests clean package && \
    JAR=$(find target -maxdepth 1 -name '*.jar' \
        ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name '*-tests.jar' \
        -print -quit) && \
    cp "$JAR" target/app.jar

# --- Runtime stage: JRE-only image (no Maven/JDK) for a smaller result. ---
FROM eclipse-temurin:21-jre-alpine AS runtime

WORKDIR /app

# Run as a non-root user instead of root for better security.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder --chown=appuser:appgroup /app/target/app.jar app.jar

USER appuser

{% for env in env_vars %}
ENV {{ env.key }}={{ env.value }}
{% endfor %}

# Let the JVM size its heap based on the container's memory limit.
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
ENV SPRING_PROFILES_ACTIVE={{ spring_profile | default("production", true) }}

# Document the port the application listens on.
EXPOSE {{ port | default(8080, true) }}

# Start the application.
CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
