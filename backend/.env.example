# Database
DB_USER=dockerforge
DB_PASSWORD=dockerforge
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dockerforge

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Build
ARQ_JOB_TIMEOUT_SECONDS=600
BUILD_MAX_CONCURRENT=2

# Upload
PROJECTS_SOURCE_DIR=/var/lib/dockerforge/projects

# CORS
CORS_ORIGINS=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=dev
